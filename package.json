    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@react-native-community/cli": "latest",
    "@react-native/metro-config": "latest",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "d3-geo": "^3.1.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.3",
    "patch-package": "^8.0.1",
    "topojson-client": "^3.1.0",
    "topojson-simplify": "^3.0.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "deploy": "eas build --platform ios --profile production --local --output ./build.ipa && open -a Transporter ./build.ipa",
    "build:geo": "node scripts/buildGeoData.mjs"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|react-native-gesture-handler|react-native-reanimated|react-native-worklets))"
    ]
  },
  "private": true
}
